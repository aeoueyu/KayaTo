MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/kayato
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Gmail SMTP for signup OTPs and email reminders
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM=KayaTo <your-account@gmail.com>

# Browser push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-account@gmail.com

# Firebase Cloud Messaging for Android and iOS
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Protects GET /api/internal/reminders/run for hosted cron jobs
CRON_SECRET=replace-with-another-long-random-secret

# Optional AI integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
